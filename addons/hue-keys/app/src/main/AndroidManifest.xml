<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The Hue bridge on the home network, and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network">

        <!-- The aliases need WRITE_SECURE_SETTINGS, which the ADB shell (Remote Daemon's commands) holds, and a
             launcher granted it; ordinary apps cannot switch the lights.
             No screen and no launcher entry: a remote button's app_keys entry starts one of the aliases below
             ("io.github.rasmuskd.huekeys/.Toggle"), the activity sends one request and finishes. -->
        <activity
            android:name=".HueKeyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity-alias android:name=".Toggle" android:targetActivity=".HueKeyActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
        <activity-alias android:name=".Brighter" android:targetActivity=".HueKeyActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
        <activity-alias android:name=".Dimmer" android:targetActivity=".HueKeyActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
        <activity-alias android:name=".Low" android:targetActivity=".HueKeyActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
        <activity-alias android:name=".Half" android:targetActivity=".HueKeyActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
        <activity-alias android:name=".Full" android:targetActivity=".HueKeyActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- install.sh writes the bridge address, app key and room here with `content write`, so the key never
             sits on a command line. Write-only, one file name, and only the ADB shell may call it. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.config"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
